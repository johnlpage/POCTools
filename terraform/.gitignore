# Terraform state (contains resolved secrets in plaintext)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local Terraform directories/cache
.terraform/
.terraform.lock.hcl

# Variable files that may contain secrets (keep the example checked in)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Key material that may get generated locally
*.pem
*.key
